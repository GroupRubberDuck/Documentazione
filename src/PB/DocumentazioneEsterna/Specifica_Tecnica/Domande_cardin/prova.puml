@startuml
skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 80
skinparam linetype ortho

package "Inbound Adapter" {
    class QueryDeviceController <<Flask Blueprint>> {
        - list_use_case: GetDeviceListUseCase
        - detail_use_case: GetDeviceDetailUseCase

        + get_device_list(req: Request): Response
        + get_device_detail(req: Request): Response
    }
}

package "Application Core" {

    () "GetDeviceDetailUseCase"

    class GetDeviceDetailService <<Application Service>> {
        + get_device(query: GetDeviceDetailQuery): Device
    }

    () "FindDevicePort"

    GetDeviceDetailService - GetDeviceDetailUseCase

    GetDeviceDetailService --( FindDevicePort
}

package "Outbound Adapter" {
    class MongoDeviceAdapter <<Mongo Repository>> {
        - collection: pymongo.Collection
        + save(device: Device): void
        + register(device: Device): void
        + delete(device_id: String): void

        + find_by_id(device_id: String): Device
        + find_all(): List<DeviceSummary>
    }
}

QueryDeviceController --( GetDeviceDetailUseCase: usa
MongoDeviceAdapter - FindDevicePort

@enduml