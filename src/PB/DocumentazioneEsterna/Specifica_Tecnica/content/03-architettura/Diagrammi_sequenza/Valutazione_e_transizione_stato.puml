@startuml Valutazione_e_transizione_stato_uc26_27

actor "Utente" as utente
participant "<<Boundary>>\nVue.js" as vue
participant "<<Inbound Adapter>>\nFlask API" as flask
participant "<<Service>>\nValutazioneNodoService" as service
participant "<<Domain Entity>>\nEntitaValutazione" as domain
participant "<<Outbound Adapter>>\npymongo : DeviceRepositoryPort" as outAdapter

utente -> vue: Seleziona risposta (Sì/No/NA)
activate vue

vue -> flask: POST /api/devices/{id}/evaluate
activate flask

flask -> service: valuta_nodo(device_id, node_id, answer)
activate service

service -> outAdapter: get_valutazione(device_id)
activate outAdapter
outAdapter --> service: stato_dispositivo
deactivate outAdapter

service -> domain: applica_risposta(stato_dispositivo, node_id, answer)
activate domain

domain -> domain: Calcolo transizione\ne dipendenze (EN18031)

alt Nodo Intermedio (UC27)
    domain --> service: stato_nodo_successivo

    service -> outAdapter: aggiorna_stato(device_id, stato_nodo_successivo)
    activate outAdapter
    outAdapter --> service: success
    deactivate outAdapter

    service --> flask: ResultDTO(nodo_successivo)

else Nodo Foglia (UC27.2)
    domain --> service: risultato_fine_requisito (Pass/Fail)
    deactivate domain

    service -> outAdapter: aggiorna_stato(device_id, risultato_fine_requisito)
    activate outAdapter
    outAdapter --> service: success
    deactivate outAdapter

    service --> flask: ResultDTO(stato_finale)
end

flask --> vue: HTTP 200 OK (JSON Data)
deactivate flask

vue --> utente: Mostra prossima domanda\no esito finale
deactivate vue

@enduml