@startuml ExportReport
skinparam linetype ortho
skinparam nodesep 150
skinparam ranksep 120
skinparam classAttributeIconSize 0
skinparam PackagePadding 30

package "Inbound Adapter" {
    !include InboundAdapters/ExportReportController.puml
}

package "Application Core" {

    () "GenerateReportUseCase" 

    !include ApplicationServices/ExportReportService.puml
    !include Command/ExportReportCommand.puml

    enum ReportFormat <<enum>> {
        PDF
    }

    class ExportedFile {
        + content: IO[bytes]
        + filename: String
        + media_type: String
    }

    class EvaluationEngine {
    + evaluate(device: Device, standard: ComplianceStandard): DeviceEvaluationResult
    - evaluate_asset(asset: Asset, standard: ComplianceStandard): AssetEvaluationResult
    - resolve(requirement_id: String, standard: ComplianceStandard, asset: Asset, cache: Dict): RequirementEvaluationResult
    - aggregate_evaluation_states(states: Sequence): EvaluationState
}

    () "ReportGeneratorPort" as ReportGeneratorPort
    () "GetEvaluationSessionPort" as GetEvaluationSessionPort

    ReportGeneratorPort -[hidden]right- GetEvaluationSessionPort

    GenerateReportService -up- GenerateReportUseCase
    GenerateReportService .right.> GenerateReportCommand : legge
    GenerateReportService .down.> ExportedFile : popola
    GenerateReportService -down-> ReportGeneratorPort : usa
    GenerateReportService -down-> GetEvaluationSessionPort : usa
    GenerateReportService ..> EvaluationEngine : usa

    GenerateReportCommand ..> ReportFormat : usa
}

package "Outbound Adapter" {
    !include OutboundAdapters/PdfReportGeneratorAdapter.puml
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}

ExportReportController -down-> GenerateReportUseCase : usa

PdfReportGenerator -up- ReportGeneratorPort
InMemoryEvaluationSessionCache -up- GetEvaluationSessionPort

@enduml