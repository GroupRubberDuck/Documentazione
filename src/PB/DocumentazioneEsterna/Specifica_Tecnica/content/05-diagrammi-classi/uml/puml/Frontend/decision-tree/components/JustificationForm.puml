@startuml
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam style strictuml

class JustificationForm <<Component>>{
        - justificationInitialValue:String
        - justificationField:FieldDefinition
        -localText:String
        -isDirty:Boolean

        + JustificationForm(justificationInitialValue:String)
        -handleSubmit()
        -handleReset()
        + save(justificationString)<<emit>>

}

@enduml