@startuml
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam style strictuml


class TreeCanvas <<component>> {
  - viewBox : ViewBox
  - isPanning : Boolean
  - panStart : Point
  - {static} PADDING : Number
  - {static} NODE_HALF_WIDTH : Number
  - {static} NODE_MAX_HALF_HEIGHT : Number
  - decisionNodes : UiDecisionNode[]
  - leafNodes : UiLeafNode[]
  + TreeCanvas(nodes : LayoutNodeDTO[], edges : EdgeDTO[], activePath : String[])
  - activePath:String[]
  - viewBoxStr : String
  - onPointerDown(event : PointerEvent) 
  - onPointerMove(event : PointerEvent) 
  - onPointerUp(event : PointerEvent) 
  - isEdgeActive(edge : EdgeDTO) : Boolean
  - generateBezierPath(edge : EdgeDTO) : String
  - resolveComponent(type : String) : Component
  + selectNode(nodeId : String) <<emit>>
}

@enduml