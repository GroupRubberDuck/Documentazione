@startuml
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam style strictuml

class TreeSidebar <<component>> {

        -currentNode : NodeDTO
        - currentAnswer : Boolean
        - hasPrevious : Boolean
        -  hasNext : Boolean
        - requirementsUrl : String

  + TreeSidebar(currentNode : NodeDTO, currentAnswer : Boolean, hasPrevious : Boolean, hasNext : Boolean, requirementsUrl : String)
  - formatResult(state : String) : String
  + submit(answer : Boolean) <<emit>>
  + previous() <<emit>>
  + next() <<emit>>
  + close() <<emit>>
}

@enduml