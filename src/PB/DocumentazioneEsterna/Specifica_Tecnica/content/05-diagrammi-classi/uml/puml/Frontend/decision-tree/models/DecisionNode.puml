@startuml
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam style strictuml

class  DecisionNode{
        
        - id:String
        - type:NodeType
        - text:String
        - resultState:EvaluationResult
        - parentId:String|null
        - yesChild:String
        - noChild:String

        + DecisionNode(id:String,type:NodeType,text:String,resultState:EvaluationResult,parentId:String|null,yesChild:String,noChild:String)


        + getRenderData():NodeDTO
        + getNext():String
        + getPrevious():String
}

@enduml