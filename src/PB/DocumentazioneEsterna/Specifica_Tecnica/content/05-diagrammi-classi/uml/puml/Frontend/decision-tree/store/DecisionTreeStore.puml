@startuml
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam style strictuml

class DecisionTreeStore{

        - evaluationEngine: EvaluationEngine | null
        - apiClient: Object | null
+ answers: Map<string, boolean>
    + selectedNodeId: string | null
    + isSideBarOpen: boolean
    + activePath: string[]
    + layoutResult: LayoutResult | null
    + evaluationState: string | null
    + justification: string
    + justificationStatus: string
    + requirementsUrl: string
    + selectedNodeData: Object | null

    - refreshPath()
    - calculateLayout()

    + init(opts: Object): void
    + setAnswer(nodeId: string, answer: boolean): Promise<JSON>
    + selectNode(nodeId: string): void
    + closeSideBar(): void
    + saveJustification(text: string): Promise<JSON>
    + setEvaluationState(state: string | Object): void

}

@enduml