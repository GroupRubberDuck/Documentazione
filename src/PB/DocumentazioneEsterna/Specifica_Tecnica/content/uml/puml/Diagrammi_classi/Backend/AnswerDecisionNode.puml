@startuml AnswerDecisionNode
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 140
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    !include InboundAdapters/EvaluationDecisionNodeController.puml
}

package "Application Core" {

    () "AnswerDecisionNodeUseCase"

    class AnswerNodeCommand <<Command DTO>> {
        + session_id: String
        + asset_id: String
        + requirement_id: String
        + node_id: String
        + answer: Boolean
    }

    !include ApplicationServices/AnswerDecisionNodeService.puml

    () "GetSessionPort"
    () "SaveSessionPort"

    !include Domain/EvaluationSession.puml
    !include Domain/EvaluationSheet.puml

    ' ==========================================
    ' GABBIA STRUTTURALE (ALLINEAMENTO)
    ' ==========================================
    ' Distanziamo le porte e il command orizzontalmente sotto il service
    GetSessionPort -[hidden]right-------- SaveSessionPort
    SaveSessionPort -[hidden]right-------- AnswerNodeCommand

    ' Spingiamo le entità di dominio di lato per non interferire con il flusso principale
    EvaluationSheet -[hidden]right-------- AnswerDecisionNodeUseCase

    ' ==========================================
    ' COLLEGAMENTI INTERNI AL CORE (Top-Down)
    ' ==========================================
    AnswerDecisionNodeUseCase -down- AnswerDecisionNodeService
    
    AnswerDecisionNodeService -down-> GetSessionPort : usa
    AnswerDecisionNodeService -down-> SaveSessionPort : usa

    AnswerDecisionNodeService .down.> AnswerNodeCommand : legge
}

package "Outbound Adapter" {
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}

' ==========================================
' COLLEGAMENTI ESTERNI (Inbound -> Core -> Outbound)
' ==========================================
EvaluationDecisionNodeController -down-> AnswerDecisionNodeUseCase : usa

GetSessionPort -down- InMemoryEvaluationSessionCache
SaveSessionPort -down- InMemoryEvaluationSessionCache

@enduml