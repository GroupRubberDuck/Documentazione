@startuml AnswerDecisionNode
skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 100
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    !include InboundAdapters/EvaluationDecisionNodeController.puml
}

package "Application Core" {

     () "AnswerDecisionNodeUseCase"

    class AnswerNodeCommand <<Command DTO>> {
        + session_id: String
        + asset_id: String
        + requirement_id: String
        + node_id: String
        + answer: Boolean
    }

    () "EvaluationSessionCachePort" as EvaluationSessionCachePort

    !include Domain/EvaluationSession.puml
    !include Domain/EvaluationSheet.puml

    AnswerDecisionNodeService -up- AnswerDecisionNodeUseCase
    
    AnswerDecisionNodeService -down-( EvaluationSessionCachePort : "richiede"

    AnswerDecisionNodeService ..> AnswerNodeCommand : "legge"
}

package "Outbound Adapter" {
    class InMemoryEvaluationSessionCache <<Session Cache>> {
        + get_session(session_id: String): EvaluationSession
        + save_session(session: EvaluationSession): void
    }
}

EvaluationDecisionNodeController -down-( AnswerDecisionNodeUseCase : "usa"
InMemoryEvaluationSessionCache -up- EvaluationSessionCachePort : "implementa"

@enduml