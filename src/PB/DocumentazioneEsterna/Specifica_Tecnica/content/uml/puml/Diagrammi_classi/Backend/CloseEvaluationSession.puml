@startuml CloseEvaluationSession

' Forza le linee ad angolo retto
skinparam linetype ortho
skinparam nodesep 150
skinparam ranksep 150
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    !include InboundAdapters/EvaluationSessionController.puml
}

package "Application Core" {

    () "CloseEvaluationSessionUseCase"

    !include ApplicationServices/CloseEvaluationSessionService.puml
    
    class CloseEvaluationSessionCommand {
        + session_id: String
    }

    () "DeleteSessionPort"

 
    CloseEvaluationSessionService -up- CloseEvaluationSessionUseCase
    CloseEvaluationSessionService .right.> CloseEvaluationSessionCommand : legge
    CloseEvaluationSessionService -down-> DeleteSessionPort : usa
}

package "Outbound Adapter" {
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}

EvaluationSessionController -left-> CloseEvaluationSessionUseCase : usa
InMemoryEvaluationSessionCache -up- DeleteSessionPort

@enduml