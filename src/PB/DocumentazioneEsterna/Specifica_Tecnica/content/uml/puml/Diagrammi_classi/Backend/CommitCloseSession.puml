@startuml CommitCloseEvaluationSession

skinparam nodesep 150
skinparam ranksep 150
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    !include InboundAdapters/EvaluationSessionController.puml
}

package "Application Core" {

    () "CommitEvaluationSessionUseCase"
    () "CloseEvaluationSessionpUseCase"

    !include ApplicationServices/CommitCloseEvaluationSessionService.puml

    !include Domain/EvaluationSession.puml
    !include Domain/Device.puml

    () "GetSessionPort"
    () "SaveDevicePort"
    () "DeleteSessionPort"

    CommitCloseEvaluationSessionService -up- CommitEvaluationSessionUseCase
    CommitCloseEvaluationSessionService -up- CloseEvaluationSessionpUseCase

    CommitCloseEvaluationSessionService --> GetSessionPort : richiede
    CommitCloseEvaluationSessionService --> SaveDevicePort : richiede
    CommitCloseEvaluationSessionService --> DeleteSessionPort: richiede
}

package "Outbound Adapter" {
    !include OutboundAdapters/MongoDeviceAdapter.puml
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}

EvaluationSessionController --> CommitEvaluationSessionUseCase : usa
EvaluationSessionController --> CloseEvaluationSessionpUseCase : usa
MongoDeviceAdapter - SaveDevicePort
InMemoryEvaluationSessionCache -up- GetSessionPort
InMemoryEvaluationSessionCache -up- DeleteSessionPort

@enduml