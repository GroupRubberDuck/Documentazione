@startuml CommitEvaluationSession

skinparam nodesep 150
skinparam ranksep 150
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    !include InboundAdapters/EvaluationSessionController.puml
}

package "Application Core" {

    () "CommitEvaluationSessionUseCase"

    !include ApplicationServices/CommitEvaluationSessionService.puml

    () "SaveDevicePort"
    () "GetSessionPort"

    !include Domain/EvaluationSession.puml
    !include Domain/Device.puml

    CommitEvaluationSessionService -up- CommitEvaluationSessionUseCase

    CommitEvaluationSessionService --> SaveDevicePort : usa
    CommitEvaluationSessionService --> GetSessionPort : usa
    CommitEvaluationSessionService .right.> CommitSessionCommand : legge
}

package "Outbound Adapter" {
    !include OutboundAdapters/MongoDeviceAdapter.puml
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}

EvaluationSessionController --> CommitEvaluationSessionUseCase : usa
MongoDeviceAdapter - SaveDevicePort
InMemoryEvaluationSessionCache -up- GetSessionPort

@enduml