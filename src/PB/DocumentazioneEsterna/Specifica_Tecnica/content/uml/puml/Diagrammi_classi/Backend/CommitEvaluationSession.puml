@startuml CommitEvaluationSession

skinparam nodesep 150
skinparam ranksep 150
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    !include InboundAdapters/EvaluationSessionController.puml
}

package "Application Core" {

    () "CommitEvaluationSessionUseCase"

    class CommitSessionCommand {
        + session_id: String
    }

    !include ApplicationServices/CommitEvaluationSessionService.puml

    () "SaveDevicePort"
    () "GetSessionPort"
    () "DeleteSessionPort"
    () "EvaluationSessionCachePort"

    !include Domain/EvaluationSession.puml
    !include Domain/Device.puml

    CommitEvaluationSessionService -up- CommitEvaluationSessionUseCase

    CommitEvaluationSessionService -right-( SaveDevicePort : richiede

    CommitEvaluationSessionService --( DeleteSessionPort
    CommitEvaluationSessionService --( GetSessionPort
    DeleteSessionPort -( EvaluationSessionCachePort
    GetSessionPort --( EvaluationSessionCachePort

    CommitEvaluationSessionService ..> CommitSessionCommand : legge
}

package "Outbound Adapter" {
    !include OutboundAdapters/MongoDeviceAdapter.puml
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}

EvaluationSessionController -left-( CommitEvaluationSessionUseCase : usa
MongoDeviceAdapter -up- SaveDevicePort
InMemoryEvaluationSessionCache -up- EvaluationSessionCachePort

@enduml