@startuml CreateAsset
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80
skinparam classAttributeIconSize 0

package "Inbound Adapter"{
    !include InboundAdapters/WriteAssetController.puml
}

package "Application Core" {

    class CreateAssetCommand {
        + name:String
        + type:AssetType
        + description:String
        + session_id: String
    }

    () "CreateAssetUseCase"
    !include ApplicationServices/CreateAssetService.puml
    !include Domain/Asset.puml
    () "SaveSessionPort"
    () "GetSessionPort"

    CreateAssetService .left.> CreateAssetCommand: legge
}

package "Outbound Adapter" {
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}


CreateAssetService - CreateAssetUseCase


CreateAssetService --> SaveSessionPort : usa
CreateAssetService --> GetSessionPort : usa

SaveSessionPort -- InMemoryEvaluationSessionCache
GetSessionPort -- InMemoryEvaluationSessionCache

WriteAssetController --> CreateAssetUseCase : usa

@enduml