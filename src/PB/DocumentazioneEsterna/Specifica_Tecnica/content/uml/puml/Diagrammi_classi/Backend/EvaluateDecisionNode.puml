@startuml EvaluateDecisionNode
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 140
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    !include InboundAdapters/EvaluationDecisionNodeController.puml
}

package "Application Core" {

    () "EvaluateDecisionNodeUseCase"

    class EvaluateDecisionNodeCommand <<Command>> {
        + session_id: String
        + asset_id: String
        + requirement_id: String
        + node_id: String
        + answer: Boolean
    }

    !include ApplicationServices/EvaluateDecisionNodeService.puml

    () "GetSessionPort"
    () "SaveSessionPort"


    GetSessionPort -[hidden]right-------- SaveSessionPort
    SaveSessionPort -[hidden]right-------- EvaluateDecisionNodeCommand



    EvaluateDecisionNodeUseCase -down- EvaluateDecisionNodeService
    
    EvaluateDecisionNodeService -down-> GetSessionPort : usa
    EvaluateDecisionNodeService -down-> SaveSessionPort : usa

    EvaluateDecisionNodeService .down.> EvaluateDecisionNodeCommand : legge
}

package "Outbound Adapter" {
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}


EvaluationDecisionNodeController -down-> EvaluateDecisionNodeUseCase : usa

GetSessionPort -down- InMemoryEvaluationSessionCache
SaveSessionPort -down- InMemoryEvaluationSessionCache

@enduml