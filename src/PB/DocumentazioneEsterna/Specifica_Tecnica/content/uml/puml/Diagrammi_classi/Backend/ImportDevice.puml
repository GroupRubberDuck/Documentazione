@startuml import-device
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 200
skinparam ranksep 100

package "Inbound Adapter" {
    !include InboundAdapters/ImportDeviceController.puml
}

package "Application Core" {

    () "ImportDeviceUseCase"

    class ImportDeviceService <<Application Service>> {
        -register_device_port: RegisterDevicePort
        -device_importer_factory: FileDeviceImporterFactoryPort
        +__init__(device_importer_factory: FileDeviceImporterFactoryPort, register_device_port: RegisterDevicePort)
        +import_device(command: ImportDeviceCommand): void
    }

    enum AllowedDeviceFileExtension <<enum>> {
        CSV
        XML
        JSON
    }

    class ImportDeviceCommand {
        + device_file_content: BinaryIO
        + extension: AllowedDeviceFileExtension
    }

    () "FileDeviceImporterFactoryPort" as FactoryPort
    () "FileDeviceImporterPort" as ImporterPort
    () "RegisterDevicePort" as RegPort

    FactoryPort -[hidden]right--------- ImporterPort
    ImporterPort -[hidden]right--------- RegPort

    ImportDeviceService .right.> ImportDeviceCommand : legge
}

package "Outbound Adapter" {
    abstract class FileDeviceImporter <<Template Method>> {
        + parse_device_file(device_file_content: BinaryIO): Device
        # check_metadata()
        # open_stream()
        # parse_data()
        # close_stream()
    }

    class CSVFileDeviceImporter {
        # check_metadata()
        # open_stream()
        # parse_data()
        # close_stream()
    }

    class JSONFileDeviceImporter {
        # check_metadata()
        # open_stream()
        # parse_data()
        # close_stream()
    }

    class XMLFileDeviceImporter {
        # check_metadata()
        # open_stream()
        # parse_data()
        # close_stream()
    }

    class ConcreteFileDeviceImporterFactory {
        + get_file_device_importer(extension: AllowedDeviceFileExtension): FileDeviceImporterPort
    }

    !include OutboundAdapters/MongoDeviceAdapter.puml

    ConcreteFileDeviceImporterFactory -[hidden]right--------- FileDeviceImporter
    FileDeviceImporter -[hidden]right--------- MongoDeviceAdapter
}

ImportDeviceController -down-> ImportDeviceUseCase : usa
ImportDeviceUseCase -down- ImportDeviceService

ImportDeviceService -down-> FactoryPort : usa
ImportDeviceService -down-> ImporterPort : usa
ImportDeviceService -down-> RegPort : usa

FactoryPort -down- ConcreteFileDeviceImporterFactory
ImporterPort -down- FileDeviceImporter
RegPort -down- MongoDeviceAdapter

ConcreteFileDeviceImporterFactory .down.> CSVFileDeviceImporter : usa
ConcreteFileDeviceImporterFactory .down.> JSONFileDeviceImporter : usa
ConcreteFileDeviceImporterFactory .down.> XMLFileDeviceImporter : usa

FileDeviceImporter <|-down- CSVFileDeviceImporter
FileDeviceImporter <|-down- JSONFileDeviceImporter
FileDeviceImporter <|-down- XMLFileDeviceImporter

@enduml