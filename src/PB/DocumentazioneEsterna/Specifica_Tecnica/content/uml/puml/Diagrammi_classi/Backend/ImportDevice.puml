@startuml import-device
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 100

package "Inbound Adapter" {
    !include InboundAdapters/ImportDeviceController.puml
}

package "Application Core" {

    () "ImportDeviceUseCase"

    !include ApplicationServices/ImportDeviceService.puml

    enum AllowedDeviceFileExtension <<enum>> {
        CSV
        XML
        JSON
    }

    class ImportDeviceCommand {
        + device_file_content: BinaryIO
        + extension: AllowedDeviceFileExtension
    }

    () "FileDeviceImporterFactoryPort"
    () "FileDeviceImporterPort"
    () "RegisterDevicePort"

    ImportDeviceService .right.> ImportDeviceCommand : legge
}

package "Outbound Adapter" {
    abstract class FileDeviceImporter <<Template Method>> {
        + parse_device_file(device_file_content: BinaryIO): Device
        # check_metadata()
        # open_stream()
        # parse_data()
        # close_stream()
    }

    class CSVFileDeviceImporter {
        # check_metadata()
        # open_stream()
        # parse_data()
        # close_stream()
    }

    class JSONFileDeviceImporter {
        # check_metadata()
        # open_stream()
        # parse_data()
        # close_stream()
    }

    class XMLFileDeviceImporter {
        # check_metadata()
        # open_stream()
        # parse_data()
        # close_stream()
    }

    class ConcreteFileDeviceImporterFactory {
        + get_file_device_importer(extension: AllowedDeviceFileExtension): FileDeviceImporterPort
    }

    !include OutboundAdapters/MongoDeviceAdapter.puml
}

ImportDeviceController -down-> ImportDeviceUseCase : usa

ImportDeviceUseCase -down- ImportDeviceService

ImportDeviceService -down-> FileDeviceImporterFactoryPort : usa
ImportDeviceService .down.> FileDeviceImporterPort : usa
ImportDeviceService -down-> RegisterDevicePort : usa

FileDeviceImporterFactoryPort -down- ConcreteFileDeviceImporterFactory
ConcreteFileDeviceImporterFactory .up.> CSVFileDeviceImporter : usa
ConcreteFileDeviceImporterFactory .up.> JSONFileDeviceImporter : usa
ConcreteFileDeviceImporterFactory .up.> XMLFileDeviceImporter : usa

FileDeviceImporterPort -down- FileDeviceImporter
FileDeviceImporter <|-down- CSVFileDeviceImporter
FileDeviceImporter <|-down- JSONFileDeviceImporter
FileDeviceImporter <|-down- XMLFileDeviceImporter

RegisterDevicePort -down- MongoDeviceAdapter

@enduml