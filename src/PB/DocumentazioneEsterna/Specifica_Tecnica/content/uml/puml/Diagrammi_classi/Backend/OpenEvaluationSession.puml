@startuml OpenEvaluationSession

skinparam nodesep 150
skinparam ranksep 150
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    !include InboundAdapters/EvaluationSessionController.puml
}

package "Application Core" {

    () "OpenEvaluationSessionUseCase"

    !include ApplicationServices/OpenEvaluationSessionService.puml

    class SessionCoordinator <<Domain Service>> {
        + can_open_session(session_type: SessionType): bool
    }

    () "FindDevicePort"
    () "FindStandardPort"
    () "CreateSessionPort"

    !include Domain/EvaluationSession.puml

    OpenEvaluationSessionService -up- OpenEvaluationSessionUseCase

    OpenEvaluationSessionService -right-> FindDevicePort : richiede
    OpenEvaluationSessionService -down-> FindStandardPort : richiede
    OpenEvaluationSessionService -down-> CreateSessionPort : richiede

}

package "Outbound Adapter" {
    !include OutboundAdapters/MongoDeviceAdapter.puml
    !include OutboundAdapters/MongoStandardAdapter.puml
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}

EvaluationSessionController -right-> OpenEvaluationSessionUseCase : usa
MongoDeviceAdapter -up- FindDevicePort
MongoStandardAdapter -up- FindStandardPort
InMemoryEvaluationSessionCache -up- CreateSessionPort

@enduml