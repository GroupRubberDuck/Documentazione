@startuml dashboard
skinparam linetype ortho
skinparam nodesep 110
skinparam ranksep 130
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    class FlaskDashboardQueryController <<Flask Blueprint>> {
        - query_service: DashboardQueryUseCase
        + get_device_dashboard(): Response
        + get_asset_detail(): Response
    }
}

package "Application Core" {

    interface DashboardQueryUseCase <<Inbound Port>> {
        + get_device_dashboard(session_id: String): DashboardDTO
        + get_asset_detail(session_id: String, asset_id: String): AssetDetailDTO
    }

    !include ports/out/EvaluationSessionCachePort.puml

    !include ApplicationServices/DashboardQueryService.puml

    class DashboardDTO <<DTO>> {
        + device_id: String
        + device_name: String
        + operating_system: String
        + description: String
        + state: EvaluationState
        + assets_list: List<AssetSummaryDTO>
    }

    class AssetSummaryDTO <<DTO>> {
        + asset_id: String
        + name: String
        + type: AssetType
        + state: EvaluationState
    }

    class AssetDetailDTO <<DTO>> {
        + asset_id: String
        + name: String
        + type: AssetType
        + description: String
        + state: EvaluationState
        + requirements_list: List<RequirementEvalDTO>
    }

    class RequirementEvalDTO <<DTO>> {
        + code: String
        + state: EvaluationState
    }

    '!include Dominio/EvaluationSession.puml
    '!include Dominio/EvaluationSheet.puml

    DashboardQueryUseCase <|.. DashboardQueryService : "implementa"
    DashboardQueryService -down-( EvaluationSessionCachePort : "richiede"

    DashboardQueryService ..> EvaluationSession : "legge"

    DashboardQueryService ..> DashboardDTO : "popola"
    DashboardQueryService ..> AssetDetailDTO : "popola"
    DashboardDTO *-- AssetSummaryDTO
    AssetDetailDTO *-- RequirementEvalDTO
}

package "Outbound Adapter" {
    !include OutboundAdapters/InMemoryEvaluationSessionCache.puml
}

FlaskDashboardQueryController -( DashboardQueryUseCase : "utilizza"
EvaluationSessionCachePort -down- InMemoryEvaluationSessionCache : "implementa"

@enduml