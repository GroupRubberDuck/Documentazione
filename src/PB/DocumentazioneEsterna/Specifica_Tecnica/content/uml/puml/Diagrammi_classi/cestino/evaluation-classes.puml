@startuml evaluation
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam Linetype ortho

package "Inbound Adapter" <<Rectangle>> {
  class FlaskEvaluationController <<Flask Blueprint>> {
    - valutazione_port: FlaskEvaluationController
    + __init__(valutazione_port: FlaskEvaluationController)
      + answer_node(): void
      + add_justification(): void
      + get_requirement_evaluation(): EvaluationStatus  
      ' + get_evaluated_requirement_detail(): EvaluatedRequirementsDTO  

  
  }
  class Request <<Flask>> {
  }

  note right of Request
    Oggetto globale di Flask.
    Accessibile tramite import
    nei metodi dei request handler
    per estrarre i dati della
    richiesta HTTP corrente.
  end note
}

package "business logic"{

package "Application Services" <<Rectangle>>  {

    class EvaluationService <<Application Service>> {
      - session_cache: SessionCachePort
      + __init__(session_cache: SessionCachePort)
      + answer_node(session_id: string,dto: AnswerNodeDTO): void
      + add_justification(session_id: string, dto: JustificationDTO): void
      + get_requirement_evaluation(session_id: string): EvaluationStatus  
      ' + get_evaluated_requirement_detail(session_id: string): EvaluatedRequirementsDTO  
  
    }
}
package "Inbound Ports" <<Rectangle>> {
    interface EvaluationUseCase <<interface>> {
      + answer_node(session_id: string,dto: AnswerNodeDTO): void
      + add_justification(session_id: string, dto: JustificationDTO): void
      + get_requirement_evaluation(session_id: string): EvaluationStatus  
      ' + get_evaluated_requirement_detail(session_id: string): EvaluatedRequirementsDTO  
  }




}

package "Outbound Ports" <<Rectangle>> {
!include ports/out/EvaluationSessionCachePort.puml



}

package "Domain" <<Rectangle>> {

!include Dominio/EvaluationSheet.puml

class AnswerNodeDTO{
  asset_id:String
  requirement_id:String
  node_id:string
  answer:bool
}





  enum StatoValutazione {
    IN_CORSO
    PASS
    FAIL
    NA
  }


}
}
package "Outbound Adapter" {
  class InMemoryEvaluationSessionCache {
    - sessions: dictionary[string:EvaluationSession]
    + save_session(session: EvaluationSession): void
    + get_session(session_id: string): EvaluationSession
    + delete_session(session_id: string): void
    + has_active_session(): bool
  }
}



' --- Relazioni ---

' Inbound Adapter -> Ports
FlaskEvaluationController --> EvaluationUseCase : " usa"
FlaskEvaluationController ..> Request

' Inbound Ports -> Services
EvaluationUseCase <|.. EvaluationService

' Services -> Outbound Ports
EvaluationService --> EvaluationSessionCachePort

' Service -> Domain

EvaluationService ..> EvaluationSheet : "modifica"


' Outbound Adapter -> Port
EvaluationSessionCachePort <|.. InMemoryEvaluationSessionCache


@enduml