@startuml classe_dashboard_query
skinparam linetype ortho
skinparam nodesep 110
skinparam ranksep 130
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    class DashboardController <<Flask Blueprint>> {
        - queryService: DashboardQueryUseCase
        ' CORREZIONE 4: Firme pulite, il framework gestisce l'estrazione da Request
        + getDashboardDispositivo(sessionId: String): Response
        + getDettaglioAsset(sessionId: String, assetId: String): Response
    }
}

package "Application Core" {

    ' --- INBOUND PORT ---
    ' CORREZIONE 3: Interfaccia esplicita per il contratto
    interface DashboardQueryUseCase <<Inbound Port>> {
        + getDashboardDispositivo(sessionId: String): DashboardDTO
        + getDettaglioAsset(sessionId: String, assetId: String): AssetDetailDTO
    }

    ' --- OUTBOUND PORT ---
    interface SessionCachePort <<Outbound Port>> {
        + save_session(session: Session): void
        + get_session(session_id: String): Session
        + delete_session(session_id: String): void
        + has_active_session(): bool
    }

    ' --- APPLICATION SERVICE ---
    class DashboardQueryService <<Application Service>> {
        - sessionCache: SessionCachePort
        + getDashboardDispositivo(sessionId: String): DashboardDTO
        + getDettaglioAsset(sessionId: String, assetId: String): AssetDetailDTO
    }

    ' --- DTOs (Data Transfer Objects) ---
    class DashboardDTO <<DTO>> {
        + deviceId: String
        + deviceName: String
        + operatingSystem: String
        + description: String
        + statoAggregato: EvaluationState
        + listaAsset: List<AssetSummaryDTO>
    }

    class AssetSummaryDTO <<DTO>> {
        + assetId: String
        + name: String
        + type: AssetType
        + statoAggregato: EvaluationState
    }

    class AssetDetailDTO <<DTO>> {
        + assetId: String
        + name: String
        + type: AssetType
        + description: String
        + statoAggregato: EvaluationState
        + listaRequisiti: List<RequirementEvalDTO>
    }

    class RequirementEvalDTO <<DTO>> {
        + codiceRequisito: String
        + statoValutazione: EvaluationState
    }

    ' --- DOMAIN ENTITIES ---
    class Session <<Entity>> {
        - sessionId: String
        - sessionType: SessionType
        + getEvaluationSheet(): EvaluationSheet
    }

    class EvaluationSheet <<Entity>> {
        ' CORREZIONE 2: Lettura degli stati (CQRS Read) invece che ricalcolo continuo
        + getAssetEvaluationState(assetId: String): EvaluationState
        + getDeviceEvaluationState(): EvaluationState
    }

    ' CORREZIONE 1: Aggiunte entità Device e Asset per chiudere il flusso dati
    class Device <<Entity>> {
        - id: String
        - name: String
        - operatingSystem: String
        - description: String
        + getAsset(assetId: String): Asset
        + getAllAssets(): List<Asset>
    }

    class Asset <<Entity>> {
        - id: String
        - name: String
        - type: AssetType
        - description: String
    }

    ' --- RELAZIONI CORE ---
    DashboardQueryUseCase <|.. DashboardQueryService : "implementa"
    
    ' Il Service si aggancia alla porta di Cache corretta
    DashboardQueryService -down-( SessionCachePort : "richiede"

    ' Il Service legge la sessione e usa l'EvaluationSheet e il Device per i calcoli
    DashboardQueryService ..> Session : "legge"
    Session *-- "1" EvaluationSheet : "contiene"
    EvaluationSheet *-- "1" Device : "valuta"
    Device *-- "*" Asset : "contiene"

    ' Relazioni DTO
    DashboardQueryService ..> DashboardDTO : "popola"
    DashboardQueryService ..> AssetDetailDTO : "popola"
    DashboardDTO *-- AssetSummaryDTO
    AssetDetailDTO *-- RequirementEvalDTO
}

package "Outbound Adapter" {
    class InMemorySessionCache <<Cache Adapter>> {
        - sessions: dictionary[string:Session]
        + save_session(session: Session): void
        + get_session(session_id: String): Session
        + delete_session(session_id: String): void
        + has_active_session(): bool
    }
}

' --- WIRING ESTERNO ---
DashboardController -( DashboardQueryUseCase : "utilizza"
SessionCachePort -down- InMemorySessionCache : "implementa"

@enduml