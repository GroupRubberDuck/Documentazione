@startuml classe_monitoraggio
skinparam linetype ortho
skinparam nodesep 150
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    class DashboardController <<Adapter>> {
        + getStatistiche(req: Request): Response
        + getStoricoSessioni(req: Request): Response
    }
}

package "Business Logic" {
    class StatisticheDTO <<DTO>> {
        + sessioniTotali: int
        + sessioniCompletate: int
        + sessioniSospese: int
        + percentualeCompletamento: float
    }

    () "InterfaceMonitoraggioUseCase" as InboundPort
    () "InterfaceMonitoraggioReadRepository" as OutboundPort

    class MonitoraggioService <<Service>> {
        - repository: InterfaceMonitoraggioReadRepository
        + calcolaStatistiche(): StatisticheDTO
        + recuperaStorico(dispId: String): List<SessioneValutazione>
    }

    MonitoraggioService ..> StatisticheDTO : " popola"
    InboundPort -down- MonitoraggioService : " fornisce"
    MonitoraggioService -down-( OutboundPort : " richiede"
}

package "Outbound Adapter" {
    class MongoMonitoraggioAdapter <<Adapter>> {
        - db: pymongo.Database
        + countSessioniByStato(): Map<String, int>
        + findSessioniByDispositivo(dispId: String): List<SessioneValutazione>
    }
}

' Flusso Inbound (dall'esterno verso il Core)
DashboardController -( InboundPort : " richiede"
DashboardController ..> StatisticheDTO : " usa"

' Flusso Outbound (dall'esterno che realizza il Core)
OutboundPort -down- MongoMonitoraggioAdapter : " fornisce"

@enduml