@startuml classe_navigazione
skinparam linetype ortho
skinparam nodesep 150
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    class NavigazioneController <<Adapter>> {
        + getDettaglioRequisito(reqId: String, req: Request): Response
        + getNodoCorrente(reqId: String, req: Request): Response
        + inviaRisposta(nodoId: String, dto: RispostaDTO, req: Request): Response
        + vaiAlProssimoNodo(reqId: String, req: Request): Response
        + vaiAlNodoPrecedente(reqId: String, req: Request): Response
        + salvaGiustificazione(reqId: String, dto: GiustificazioneDTO, req: Request): Response
    }
}

package "Business Logic" {
    class RispostaDTO <<DTO>> {
        + risposta: Enum<YES, NO>
    }
    
    class GiustificazioneDTO <<DTO>> {
        + testoGiustificazione: String
    }

    () "InterfaceNavigazioneUseCase" as InboundPort
    () "InterfaceDecisionTreeRepository" as OutboundPort

    class NavigazioneService <<Service>> {
        - repository: InterfaceDecisionTreeRepository
        + avviaValutazioneRequisito(reqId: String): Nodo
        + valutaNodo(nodoId: String, risposta: RispostaDTO): Nodo
        + calcolaProssimoNodo(reqId: String): Nodo
        + tornaIndietro(reqId: String): Nodo
        + aggiungiGiustificazione(reqId: String, testo: String): void
        - verificaRispostaObbligatoria(n: Nodo): void
        - aggiornaStatoRequisitoSeFoglia(n: NodoFoglia): void
    }

    abstract class Nodo <<Domain>> {
        - id: String
        - requisitoId: String
    }
    
    class NodoDecisionale extends Nodo {
        - domanda: String
        - rispostaAttuale: Enum<YES, NO>
        - nodoYesId: String
        - nodoNoId: String
    }
    
    class NodoFoglia extends Nodo {
        - esitoValutazione: StatoValutazione <PASS, FAIL, NA>
    }

    NavigazioneService "1" *-right- "*" Nodo : " elabora"
    InboundPort -down- NavigazioneService : " fornisce"
    NavigazioneService -down-( OutboundPort : " richiede"
    NavigazioneService ..> RispostaDTO : " riceve"
}

package "Outbound Adapter" {
    class MongoDecisionTreeAdapter <<Adapter>> {
        - collection: pymongo.Collection
        + getGrafoRequisito(reqId: String): AlberoDecisionale
        + saveStatoNavigazione(reqId: String, stato: Map): void
        + findNodoById(nodoId: String): Nodo
    }
}

' Flusso Inbound
NavigazioneController -( InboundPort : " richiede"
NavigazioneController ..> RispostaDTO : " usa"

' Flusso Outbound
OutboundPort -down- MongoDecisionTreeAdapter : " fornisce"

@enduml