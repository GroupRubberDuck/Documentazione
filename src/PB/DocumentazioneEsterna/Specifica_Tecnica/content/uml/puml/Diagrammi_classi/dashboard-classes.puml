@startuml dashboard
skinparam linetype ortho
skinparam nodesep 110
skinparam ranksep 130
skinparam classAttributeIconSize 0

package "Inbound Adapter" {
    class DashboardController <<Flask Blueprint>> {
        - query_service: DashboardQueryUseCase
        + get_dashboard_dispositivo(session_id: String): Response
        + get_dettaglio_asset(session_id: String, asset_id: String): Response
    }
}

package "Application Core" {

    interface DashboardQueryUseCase <<Inbound Port>> {
        + get_dashboard_dispositivo(session_id: String): DashboardDTO
        + get_dettaglio_asset(session_id: String, asset_id: String): AssetDetailDTO
    }

    interface SessionCachePort <<Outbound Port>> {
        + save_session(session: Session): void
        + get_session(session_id: String): Session
        + delete_session(session_id: String): void
        + has_active_session(): bool
    }

    class DashboardQueryService <<Application Service>> {
        - session_cache: SessionCachePort
        + get_dashboard_dispositivo(session_id: String): DashboardDTO
        + get_dettaglio_asset(session_id: String, asset_id: String): AssetDetailDTO
    }

    class DashboardDTO <<DTO>> {
        + device_id: String
        + device_name: String
        + operating_system: String
        + description: String
        + stato_aggregato: EvaluationState
        + lista_asset: List<AssetSummaryDTO>
    }

    class AssetSummaryDTO <<DTO>> {
        + asset_id: String
        + name: String
        + type: AssetType
        + stato_aggregato: EvaluationState
    }

    class AssetDetailDTO <<DTO>> {
        + asset_id: String
        + name: String
        + type: AssetType
        + description: String
        + stato_aggregato: EvaluationState
        + lista_requisiti: List<RequirementEvalDTO>
    }

    class RequirementEvalDTO <<DTO>> {
        + codice_requisito: String
        + stato_valutazione: EvaluationState
    }

    !include Dominio/Session.puml
    !include Dominio/EvaluationSheet.puml

    DashboardQueryUseCase <|.. DashboardQueryService : "implementa"
    DashboardQueryService -down-( SessionCachePort : "richiede"

    DashboardQueryService ..> Session : "legge"

    DashboardQueryService ..> DashboardDTO : "popola"
    DashboardQueryService ..> AssetDetailDTO : "popola"
    DashboardDTO *-- AssetSummaryDTO
    AssetDetailDTO *-- RequirementEvalDTO
}

package "Outbound Adapter" {
    class InMemorySessionCache <<Cache Adapter>> {
        - sessions: dictionary[String:Session]
        + save_session(session: Session): void
        + get_session(session_id: String): Session
        + delete_session(session_id: String): void
        + has_active_session(): bool
    }
}

DashboardController -( DashboardQueryUseCase : "utilizza"
SessionCachePort -down- InMemorySessionCache : "implementa"

@enduml