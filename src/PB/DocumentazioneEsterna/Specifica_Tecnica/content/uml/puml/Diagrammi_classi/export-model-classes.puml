@startuml export-ComplianceStandard
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 100
skinparam packageStyle rectangle
skinparam style strictuml

package "Business Logic" {

  package "Logica di Dominio" {
    class ComplianceStandard {
    }

    class ComplianceStandardFileDTO {
      + ComplianceStandard_id: string
      + ComplianceStandard_name: string
      + ComplianceStandard_version_number: string
      + request_list: list[RequestDTO]
    }

    class RequirementFileDTO {
      + request_name: string
      + request_code: string
      + request_description: string
      + request_target: string
      + dependency_list: list[string]
      + assessments: list[AssessmentFileDTO]
      + decision_tree_root_node: DecisionTreeNodeFileDTO
      + justification: string
    }

    class DecisionTreeNodeFileDTO {
+ node_type: NodeType
+ question_code: string  
+ question_text: string  
+ result_status: ResultStatus  
+ YES_child: DecisionTreeNodeFileDTO
+ NO_child:  DecisionTreeNodeFileDTO
      }

    
  
  enum ResultStatus <<enum>>{
    PASS
    FAIL
    NOT_APPLICABLE
  } 
  
  enum NodeType <<enum>>{
    DECISION_NODE
    LEAF_NODE
  } 
  
  }


  package "Logica Applicativa" {
    class ExportComplianceStandardService {
      - ComplianceStandard_repository: ComplianceStandardRepositoryPort
      - file_exporter_factory: FileComplianceStandardExporterFactoryPort
      + __init__(ComplianceStandard_repository: ComplianceStandardRepositoryPort, file_exporter_factory: FileComplianceStandardExporterFactoryPort)
      + export_ComplianceStandard(ComplianceStandard_id: string, extension: AllowedComplianceStandardFileExtension): bytes
    }

    enum AllowedComplianceStandardFileExtension {
      CSV
      XML
      JSON
    }
  }

  package "Inbound Ports" {
    interface ExportComplianceStandardPort <<interface>> {
      + export_ComplianceStandard(ComplianceStandard_id: string, extension: AllowedComplianceStandardFileExtension): bytes
    }
  }

  package "Outbound Ports" {
    interface ComplianceStandardRepositoryPort <<interface>> {
      + get_ComplianceStandard_by_id(ComplianceStandard_id: string): ComplianceStandard
    }

    interface FileComplianceStandardExporterPort <<interface>> {
      + generate_ComplianceStandard_file(ComplianceStandard_dto: ComplianceStandardFileDTO): bytes
    }

    interface FileComplianceStandardExporterFactoryPort <<interface>> {
      + get_file_ComplianceStandard_exporter(extension: AllowedComplianceStandardFileExtension): FileComplianceStandardExporterPort
    }
  }
}

package "Inbound Adapter" {
  class FlaskExportComplianceStandardController {
    - export_port: ExportComplianceStandardPort
    + __init__(export_port: ExportComplianceStandardPort)
    + export_ComplianceStandard()
  }

  class FlaskDownloadFileController <<Utility>> {
    + build_file_response(file_bytes: bytes, filename: string): FlaskResponse
  }
}

package "Outbound Adapter" {
  abstract class FileComplianceStandardExporter <<Template Method>> {
    + generate_ComplianceStandard_file(ComplianceStandard_dto: ComplianceStandardFileDTO): bytes
    # prepare_structure()
    # write_data()
    # finalize_output()
  }

  class CSVFileComplianceStandardExporter {
    # prepare_structure()
    # write_data()
    # finalize_output()
  }

  class JSONFileComplianceStandardExporter {
    # prepare_structure()
    # write_data()
    # finalize_output()
  }

  class XMLFileComplianceStandardExporter {
    # prepare_structure()
    # write_data()
    # finalize_output()
  }

  class ConcreteFileComplianceStandardExporterFactory {
    + get_file_ComplianceStandard_exporter(extension: AllowedComplianceStandardFileExtension): FileComplianceStandardExporterPort
  }
}

' --- Relazioni ---

' Inbound
FlaskExportComplianceStandardController --> ExportComplianceStandardPort : " usa"
FlaskExportComplianceStandardController .r.> FlaskDownloadFileController

' Port -> Service
ExportComplianceStandardPort <|.. ExportComplianceStandardService

' Service -> Outbound Ports
ExportComplianceStandardService -down-> ComplianceStandardRepositoryPort
ExportComplianceStandardService -down-> FileComplianceStandardExporterFactoryPort
ExportComplianceStandardService ..> ComplianceStandardFileDTO : "crea"

' Factory
FileComplianceStandardExporterFactoryPort <|.. ConcreteFileComplianceStandardExporterFactory
FileComplianceStandardExporterFactoryPort ..> FileComplianceStandardExporterPort
ConcreteFileComplianceStandardExporterFactory .up.> CSVFileComplianceStandardExporter
ConcreteFileComplianceStandardExporterFactory .up.> JSONFileComplianceStandardExporter
ConcreteFileComplianceStandardExporterFactory .up.> XMLFileComplianceStandardExporter

' Exporter hierarchy
FileComplianceStandardExporterPort <|.. FileComplianceStandardExporter
FileComplianceStandardExporter <|-down- CSVFileComplianceStandardExporter
FileComplianceStandardExporter <|-down- JSONFileComplianceStandardExporter
FileComplianceStandardExporter <|-down- XMLFileComplianceStandardExporter

' Exporter -> DTO
FileComplianceStandardExporter ..> ComplianceStandardFileDTO : "riceve"

' DTO composition
ComplianceStandardFileDTO *-- RequirementFileDTO
RequirementFileDTO *-- DecisionTreeNodeFileDTO

' ComplianceStandard -> DTO
ComplianceStandard ..> ComplianceStandardFileDTO : "si converte in"

@enduml