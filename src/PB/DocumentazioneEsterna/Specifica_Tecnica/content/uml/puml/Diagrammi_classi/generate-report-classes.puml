@startuml generate-report
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 100
skinparam packageStyle rectangle
skinparam style strictuml

package "Business Logic" {

  package "Logica di Dominio" {
    class Device {
    }




  }

  package "Logica Applicativa" {
    class GenerateReportService {
      - session_cache: EvaluationSessionCachePort
      - report_generator: ReportGeneratorPort
      + __init__(device_repository: DeviceRepositoryPort, report_generator: ReportGeneratorPort)
      + generate_report(device_id: string): bytes
    }
  }

  package "Inbound Ports" {
    interface GenerateReportUseCase <<interface>> {
      + generate_report(device_id: string): bytes
    }
  }

  package "Outbound Ports" {
!include ports/out/EvaluationSessionCachePort.puml

    interface ReportGeneratorPort <<interface>> {
      + generate_report(report_dto: ReportDTO): bytes
    }
  }
}

package "Inbound Adapter" {
  class FlaskReportGeneratorController {
    - report_port: GenerateReportUseCase
    + __init__(report_port: GenerateReportUseCase)
    + generate_report()
  }

  class FlaskDownloadFileController <<Utility>> {
    + build_file_response(file_bytes: bytes, filename: string): FlaskResponse
  }
}

package "Outbound Adapter" {
  class PDFReportGenerator {
    + generate_report(device:Device,standard:ComplianceStandard ): bytes
  }
}

' --- Relazioni ---

' Inbound
FlaskReportGeneratorController --> GenerateReportUseCase : " usa"
FlaskReportGeneratorController ..> FlaskDownloadFileController

' Port -> Service
GenerateReportUseCase <|.. GenerateReportService

' Service -> Outbound Ports
GenerateReportService -down-> EvaluationSessionCachePort
GenerateReportService -down-> ReportGeneratorPort

' Service -> Domain
GenerateReportService ..> Device : "recupera"


' Outbound Adapter -> Port
ReportGeneratorPort <|.. PDFReportGenerator

' Adapter -> DTO
PDFReportGenerator ..> ReportDTO : "riceve"



@enduml