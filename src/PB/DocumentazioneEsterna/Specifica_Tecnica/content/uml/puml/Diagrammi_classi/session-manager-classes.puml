@startuml session-manager
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 100
skinparam packageStyle rectangle
skinparam style strictuml

package "Business Logic" {

  package "Logica di Dominio" {
    class SessionManager {
      + can_open_session(active_session_exists: bool): bool
      + get_allowed_session_types(): list[SessionType]
    }

    class Session {
      - session_id: string
      - session_type: SessionType
      - report: Report
      + get_report(): Report
    }

    class Report {
      - device: Device
      - model: Model
      + answer_node(node_code: string, answer: bool): void
      + add_justification(asset_id: string, requirement_code: string, text: string): void
      + add_asset(name: string, asset_type: AssetType, description: string): void
      + update_asset(asset_id: string, name: string, asset_type: AssetType, description: string): void
      + remove_asset(asset_id: string): void
      + get_all_assets(): list[Asset]
    }

    class Device <<Aggregate Root>> {
    }

    class Model {
    }

    enum SessionType <<enum>> {
      VALUTAZIONE
      EDITING_MODELLO
    }
  }

  package "Logica Applicativa" {
    class SessionService <<Application Service>> {
      - session_manager: SessionManager
      - session_cache: SessionCachePort
      - device_reader: DeviceReaderPort
      - model_reader: ModelReaderPort
      - device_writer: DeviceWriterPort
      + __init__(session_manager: SessionManager, session_cache: SessionCachePort, device_reader: DeviceReaderPort, model_reader: ModelReaderPort, device_writer: DeviceWriterPort)
      + open_session(device_id: string, model_id: string): string
      + commit(): void
      + rollback(): void
    }

    class ValutazioneService <<Application Service>> {
      - session_cache: SessionCachePort
      + __init__(session_cache: SessionCachePort)
      + answer_node(session_id: string, dto: AnswerNodeDTO): void
      + add_justification(session_id: string, dto: JustificationDTO): void
      + get_valutazione_status(session_id: string): ValutazioneStatusDTO
    }

    class AssetSessionService <<Application Service>> {
      - session_cache: SessionCachePort
      + __init__(session_cache: SessionCachePort)
      + add_asset(session_id: string, dto: CreaAssetDTO): bool
      + update_asset(session_id: string, asset_id: string, dto: ModificaAssetDTO): bool
      + delete_asset(session_id: string, asset_id: string): void
      + get_lista_asset(session_id: string): list[AssetSummaryDTO]
      + get_dettaglio_asset(session_id: string, asset_id: string): AssetDetailDTO
    }
  }

  package "Inbound Ports" {
    interface SessionPort <<interface>> {
      + open_session(device_id: string, model_id: string): string
      + commit(): void
      + rollback(): void
    }

    interface ValutazionePort <<interface>> {
      + answer_node(session_id: string, dto: AnswerNodeDTO): void
      + add_justification(session_id: string, dto: JustificationDTO): void
      + get_valutazione_status(session_id: string): ValutazioneStatusDTO
    }

    interface AssetSessionPort <<interface>> {
      + add_asset(session_id: string, dto: CreaAssetDTO): bool
      + update_asset(session_id: string, asset_id: string, dto: ModificaAssetDTO): bool
      + delete_asset(session_id: string, asset_id: string): void
      + get_lista_asset(session_id: string): list[AssetSummaryDTO]
      + get_dettaglio_asset(session_id: string, asset_id: string): AssetDetailDTO
    }
  }

  package "Outbound Ports" {
    interface SessionCachePort <<interface>> {
      + save_session(session: Session): void
      + get_session(session_id: string): Session
      + delete_session(session_id: string): void
      + has_active_session(): bool
    }

    interface DeviceReaderPort <<interface>> {
      + get_device_by_id(device_id: string): Device
    }

    interface DeviceWriterPort <<interface>> {
      + save_device(device: Device): void
    }

    interface ModelReaderPort <<interface>> {
      + get_model_by_id(model_id: string): Model
    }
  }
}

package "Inbound Adapter" {
  class FlaskSessionRequestHandler <<Flask Blueprint>> {
    - session_port: SessionPort
    + __init__(session_port: SessionPort)
    + open_session(): Response
    + commit(): Response
    + rollback(): Response
  }

  class FlaskValutazioneRequestHandler <<Flask Blueprint>> {
    - valutazione_port: ValutazionePort
    + __init__(valutazione_port: ValutazionePort)
    + answer_node(session_id: string): Response
    + add_justification(session_id: string): Response
    + get_status(session_id: string): Response
  }

  class FlaskAssetSessionRequestHandler <<Flask Blueprint>> {
    - asset_session_port: AssetSessionPort
    + __init__(asset_session_port: AssetSessionPort)
    + add_asset(session_id: string): Response
    + update_asset(session_id: string, asset_id: string): Response
    + delete_asset(session_id: string, asset_id: string): Response
    + get_lista_asset(session_id: string): Response
    + get_dettaglio_asset(session_id: string, asset_id: string): Response
  }

  class Request <<Flask>> {
  }

  note right of Request
    Oggetto globale di Flask.
    Accessibile tramite import
    nei metodi dei request handler
    per estrarre i dati della
    richiesta HTTP corrente.
  end note
}

package "Outbound Adapter" {
  class InMemorySessionCache {
    - sessions: dictionary[string:Session]
    + save_session(session: Session): void
    + get_session(session_id: string): Session
    + delete_session(session_id: string): void
    + has_active_session(): bool
  }
}

' --- Relazioni ---

' Inbound Adapter -> Ports
FlaskSessionRequestHandler --> SessionPort : " usa"
FlaskValutazioneRequestHandler --> ValutazionePort : " usa"
FlaskAssetSessionRequestHandler --> AssetSessionPort : " usa"
FlaskSessionRequestHandler ..> Request
FlaskValutazioneRequestHandler ..> Request
FlaskAssetSessionRequestHandler ..> Request

' Inbound Ports -> Services
SessionPort <|.. SessionService
ValutazionePort <|.. ValutazioneService
AssetSessionPort <|.. AssetSessionService

' Services -> Outbound Ports
SessionService --> SessionCachePort
SessionService --> DeviceReaderPort
SessionService --> DeviceWriterPort
SessionService --> ModelReaderPort
ValutazioneService --> SessionCachePort
AssetSessionService --> SessionCachePort

' Service -> Domain
SessionService ..> SessionManager : "usa"
SessionService ..> Session : "crea"
SessionService ..> Report : "crea"
ValutazioneService ..> Report : "modifica"
AssetSessionService ..> Report : "modifica"

' Domain interno
Session o-- Report
Report o-- Device
Report o-- Model
SessionManager ..> SessionType

' Outbound Adapter -> Port
SessionCachePort <|.. InMemorySessionCache

@enduml