@startuml Frontend_Decision_Tree
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 80
skinparam packageStyle rectangle
skinparam style strictuml


' package "Store and Services"{
package "Store Pinia" {
  class useDecisionTreeStore <<Pinia Store>> {
    + tree_structure: TreeStructure
    + node_answers: dictionary[string:bool]
    + selected_node_id: string | null
    + selected_node_data: computed
    + is_sidebar_open: computed
    + loadTree(initial_data: JSON): void
    + selectNode(node_id: string): void
    + setAnswer(node_id: string, answer: bool): void
    + setJustification(node_id: string, text: string): void
    + confirmAnswer(node_id: string): void
    + revertAnswer(node_id: string): void
  }
}

package "Service Layer" {
  class D3LayoutService {
    + calculateLayout(tree_structure: TreeStructure): LayoutResult
  }

  class ValutazioneApiClient {
    + sendAnswer(session_id: string, dto: AnswerNodeDTO): Promise
    + sendJustification(session_id: string, dto: JustificationDTO): Promise
  }
}
' }



package "Componenti Vue" {
  class DecisionTreeWidget <<Vue Component>> {
    - props: treeData (JSON)
    + onMounted(): void
    + onNodeClick(node_id: string): void
  }

  class TreeNodeComponent <<Vue Component>> {
    - props: node_id, x, y, node_type, status
    + emit: node-clicked(node_id: string)
  }

  class NodeDetailSidebar <<Vue Component>> {
    + submitAnswer(): void
    + submitJustification(): void
    + closeSidebar(): void
  }

  note bottom of DecisionTreeWidget
    Riceve i dati iniziali dell'albero
    come prop JSON da Jinja2.
    Al mount carica i dati nello store
    e calcola il layout tramite D3.
    Renderizza un SVG con
    TreeNodeComponent posizionati
    alle coordinate calcolate.
  end note
}



package "DTO" {
  class TreeStructure {
  }

  class LayoutResult {
  }

  class AnswerNodeDTO {
  }

  class JustificationDTO {
  }

  class NodeDisplayData {
  }
}

' --- Relazioni ---

' Componenti -> Store
DecisionTreeWidget --> useDecisionTreeStore : "legge e scrive"
NodeDetailSidebar --> useDecisionTreeStore : "legge e scrive"

' Componenti interni
DecisionTreeWidget *-- TreeNodeComponent : "renderizza"

' Store -> API Client
useDecisionTreeStore --> ValutazioneApiClient : "chiama"

' Componenti -> Service
DecisionTreeWidget --> D3LayoutService : "calcola layout"

' Service -> DTO
D3LayoutService ..> TreeStructure : "riceve"
D3LayoutService ..> LayoutResult : "ritorna"
ValutazioneApiClient ..> AnswerNodeDTO : "invia"
ValutazioneApiClient ..> JustificationDTO : "invia"

' Store -> DTO
useDecisionTreeStore ..> TreeStructure : "contiene"
useDecisionTreeStore ..> NodeDisplayData : "espone"

' Sidebar -> DTO
NodeDetailSidebar ..> AnswerNodeDTO : "costruisce"
NodeDetailSidebar ..> JustificationDTO : "costruisce"

note right of ValutazioneApiClient
  Incapsula le chiamate HTTP
  verso il backend Flask.
  Gestisce successo/errore
  e restituisce Promise.
end note

note right of D3LayoutService
  Funzione pura senza stato.
  Usa d3-hierarchy e d3-tree
  per calcolare posizioni
  dei nodi e path delle
  connessioni SVG.
end note

@enduml